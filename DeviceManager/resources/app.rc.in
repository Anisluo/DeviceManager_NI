// Windows resources: executable icon and version information (configured by CMake).
#pragma code_page(65001)
#include <winver.h>

IDI_ICON1 ICON "@DM_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription",  "DeviceManager 芯片测控平台"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "DeviceManager"
            VALUE "OriginalFilename", "DeviceManager.exe"
            VALUE "ProductName",      "DeviceManager"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
