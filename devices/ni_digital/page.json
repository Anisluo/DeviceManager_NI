      },
      {
       "type": "button",
       "label": "保存为新图形",
       "style": "secondary",
       "action": {
        "method": "pe.save_as",
        "args": {
         "name": "$form.pe_vec_save_name"
        }
       },
       "reload_page": true
      },
      {
       "type": "button",
       "label": "撤销修改",
       "style": "ghost",
       "action": {
        "method": "pe.revert",
        "args": {}
