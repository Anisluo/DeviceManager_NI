  {
   "title": "PPMU",
   "sections": [
    {
     "title": "源",
     "span": 4,
     "row_span": 2,
     "widgets": [
      {
       "type": "combo",
       "id": "pm_pin",
       "label": "引脚",
       "value": "PA0",
       "options_from": {
        "method": "list_pins",
        "field": "pins"
       }
      },
      {
       "type": "number",
       "id": "pm_v",
       "label": "电压",
       "unit": "V",
       "value": 1.0,
       "min": -2,
       "max": 6,
       "step": 0.1,
       "decimals": 4
      },
      {
       "type": "combo",
       "id": "pm_rng",
       "label": "电流量程",
       "value": 0.002,
       "options": [
        {
         "label": "2 µA",
         "value": 2e-06
        },
        {
         "label": "8 µA",
         "value": 8e-06
        },
        {
         "label": "32 µA",
         "value": 3.2e-05
        },
        {
         "label": "128 µA",
         "value": 0.000128
        },
        {
         "label": "512 µA",
         "value": 0.000512
        },
        {
         "label": "2 mA",
         "value": 0.002
        },
        {
         "label": "32 mA",
         "value": 0.032
        }
       ]
      },
      {
       "type": "button",
       "label": "施加电压 FV",
       "style": "primary",
       "action": {
        "method": "ppmu_force_voltage",
        "args": {
         "pins": "$form.pm_pin",
         "voltage": "$form.pm_v",
         "current_range": "$form.pm_rng"
        }
       },
       "fit": true
      },
      {
       "type": "number",
       "id": "pm_i",
       "label": "电流",
       "unit": "A",
       "value": -0.0001,
       "min": -0.032,
       "max": 0.032,
       "step": 1e-05,
       "decimals": 7
      },
      {
       "type": "number",
       "id": "pm_vlo",
       "label": "电压下限",
       "unit": "V",
       "value": -2.0,
       "step": 0.1,
       "decimals": 2
      },
      {
       "type": "number",
       "id": "pm_vhi",
       "label": "电压上限",
       "unit": "V",
       "value": 6.0,
       "step": 0.1,
       "decimals": 2
      },
      {
       "type": "button",
       "label": "施加电流 FI",
       "style": "primary",
       "action": {
        "method": "ppmu_force_current",
        "args": {
         "pins": "$form.pm_pin",
         "current": "$form.pm_i",
         "v_low": "$form.pm_vlo",
         "v_high": "$form.pm_vhi"
        }
       },
       "fit": true
      },
      {
       "type": "button",
       "label": "关闭 PPMU",
       "style": "secondary",
       "action": {
        "method": "ppmu_off",
        "args": {
         "pins": "$form.pm_pin"
        }
       },
       "fit": true
      }
     ]
    },
    {
     "title": "测量",
     "span": 8,
     "layout": "row",
     "widgets": [
      {
       "type": "readout",
       "label": "电压",
       "source": "pm",
       "field": "voltage",
       "unit": "V",
       "digits": 6
      },
      {
       "type": "readout",
       "label": "电流",
       "source": "pm",
       "field": "current",
       "unit": "A",
       "digits": 5
      }
