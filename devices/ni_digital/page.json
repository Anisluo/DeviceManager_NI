         "width": 80
        },
        {
         "field": "pin",
         "label": "引脚 / 组",
         "width": 90
        },
        {
         "field": "fmt",
         "name": "format",
         "label": "驱动格式",
         "width": 96,
         "editor": "combo",
         "options": [
          "NR",
          "RL",
          "RH",
          "SBC"
         ]
        },
        {
         "field": "On",
         "label": "On",
         "width": 110,
         "editor": "text"
        },
        {
         "field": "Data",
         "label": "Data",
         "width": 110,
         "editor": "text"
        },
        {
         "field": "Return",
         "label": "Return",
         "width": 110,
         "editor": "text",
         "readonly_if": "no_return"
        },
        {
         "field": "Off",
         "label": "Off",
         "width": 110,
         "editor": "text"
        },
        {
         "field": "Strobe",
         "label": "Strobe",
         "width": 110,
         "editor": "text"
        },
        {
         "field": "note",
         "label": "备注"
        }
       ],
       "row_actions": [
        {
         "label": "删除行",
         "method": "pe.remove_edge"
        }
       ],
       "height": 420
