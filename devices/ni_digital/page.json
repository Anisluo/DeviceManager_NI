         "all": true
        },
        "field": "timesets"
       }
      },
      {
       "type": "edit_table",
       "source": "pe_edges",
       "rows_field": "rows",
       "key": [
        "timeset",
        "pin"
       ],
       "write": "pe.set_edge",
       "also": [
        "pe_pedges",
        "pe_sum",
        "pe_tl",
        "pe_chk"
       ],
       "columns": [
        {
         "field": "timeset",
         "label": "时序集",
         "width": 120
        },
        {
         "field": "period",
