      {
       "type": "combo",
       "id": "pe_edge_ts",
       "label": "时序集",
       "options_from": {
        "method": "pe.timeset_options",
        "args": {},
        "field": "timesets"
       }
      },
      {
       "type": "combo",
       "id": "pe_edge_pin",
       "label": "引脚 / 组",
       "options_from": {
        "method": "pe.pin_options",
