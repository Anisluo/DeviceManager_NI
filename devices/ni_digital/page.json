  {
   "title": "图形编辑",
   "sections": [
    {
     "title": "图形",
     "span": 4,
     "widgets": [
      {
       "type": "combo",
       "id": "pe_vec_pat",
       "label": "图形",
       "options_from": {
        "method": "pe.list_patterns",
        "field": "patterns"
       },
       "init": {
        "method": "pe.info",
        "field": "current"
       },
       "action": {
        "method": "pe.select",
        "args": {
         "name": "$value"
        }
       }
      },
      {
       "type": "readout",
       "label": "向量数",
       "source": "pe_vec",
       "field": "vector_count",
       "digits": 5
      },
      {
       "type": "readout",
       "label": "状态",
       "source": "pe_sum",
       "field": "modified",
       "states": {
        "true": {
         "text": "已修改，未保存",
         "tone": "warning"
        },
        "false": {
         "text": "与文件一致",
         "tone": "ok"
        }
       }
      }
     ]
    },
    {
     "title": "保存",
     "subtitle": "修改先留在内存里，运行时用修改后的图形；保存才写入 .digipat",
