   "interval_ms": 1000
  },
  {
   "id": "vec",
   "method": "vectors",
   "interval_ms": 2000
  },
  {
   "id": "specs",
   "method": "specs",
   "interval_ms": 2000
  },
  {
   "id": "lv",
   "method": "levels",
   "interval_ms": 3000
  },
  {
   "id": "ts",
   "method": "timesets",
   "interval_ms": 3000
  },
  {
   "id": "pins",
   "method": "pins",
   "interval_ms": 3000
  },
  {
   "id": "edges",
