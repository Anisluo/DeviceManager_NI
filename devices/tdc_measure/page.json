       "max": 100000,
       "step": 1,
       "decimals": 0
      },
      {
       "type": "number",
       "id": "g_d2",
       "label": "OUT2 延时",
       "unit": "µs",
       "value": 200,
       "min": 0,
       "max": 1000000.0,
       "step": 1,
       "decimals": 3
      }
