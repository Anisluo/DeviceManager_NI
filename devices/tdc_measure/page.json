       "label": "CLK 时钟",
       "value": "I3",
       "options_from": {
        "method": "pin_options",
        "args": {
         "optional": true
        },
        "field": "pins"
       }
      },
      {
       "type": "combo",
       "id": "g_trig",
       "label": "TRIG 检测",
       "value": "I0",
